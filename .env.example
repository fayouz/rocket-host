# Copie ce fichier en .env puis colle ton jeton (Lodgify > Parametres > API publique)
LODGIFY_API_KEY=
# Nuki Web > Integrations > API : cree un jeton (lecture des serrures)
NUKI_API_TOKEN=
# Jeton secret pour le webhook n8n (genere avec : openssl rand -hex 24)
WEBHOOK_TOKEN=
# Mot de passe de la boite e-mail lue en IMAP (Reglages > E-mail) ; le reste se regle dans l'appli
IMAP_PASSWORD=
# Homey Pro (Reglages du logement > Domotique) : Homey web app > Reglages > Cles d'API ; droits minimaux (lire et commander les appareils)
HOMEY_API_KEY=
# Homey en mode Cloud : application creee dans tools.developer.homey.app (Web API Client). Adresse de retour a y declarer : <adresse du site>/api/homey/callback
HOMEY_CLIENT_ID=
HOMEY_CLIENT_SECRET=
HOMEY_REDIRECT_URI=
# Connexion (voir docs/plan-gestion-utilisateurs.md) : en PRODUCTION, mot de passe du premier compte 'admin' (12 caracteres au moins, a changer des la premiere connexion).
# En developpement, le compte admin/admin est cree tout seul (changement obligatoire). LH_STRICT_AUTH=1 applique les regles de production meme en developpement.
ADMIN_INITIAL_PASSWORD=
# Facultatif : cle de chiffrement des sessions (32 caracteres au moins). Sinon generee dans .data/session-secret.
SESSION_SECRET=
PORT=3000
# Laisse vide pour utiliser les vraies donnees, ou mets 1 pour voir l'app avec des donnees de demo
DEMO=

# Rocket PMS (voir docs/rocket-pms.md), facultatif : laisse vide pour continuer a parler a Lodgify/Nuki en direct comme avant
PMS_API_URL=
PMS_API_TOKEN=
# Compte Rocket PMS au nom duquel partent les e-mails (Rocket Mailer exige un utilisateur)
PMS_IMPERSONATE_USER=

# --- Deploiement Docker (voir docs/deploiement.md) ---
DOMAIN=
# Adresse pour les alertes Let's Encrypt (expiration de certificat)
ACME_EMAIL=
# openssl rand -hex 24 (a sauvegarder)
N8N_ENCRYPTION_KEY=
