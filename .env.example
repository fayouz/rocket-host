# Rocket Host : l'environnement ne contient plus que l'infrastructure. Jetons, cles, mots de passe et adresses des services
# (Lodgify, Nuki, IMAP/SMTP, Homey, Rocket PMS/Place/Clean/Stock/Cast, webhook n8n, CONNECTOR_*) se saisissent dans
# Administration > Connexions : chiffres en base (AES-256-GCM). Voir docs/secrets.md.

# Cle maitre des secrets (OBLIGATOIRE) : openssl rand -base64 32 — a sauvegarder hors du serveur (sans elle, les secrets sont perdus)
ROCKET_SECRETS_KEY=
# Rotation seulement : ancienne cle, le temps de lancer « npm run secrets:rotate » (voir docs/secrets.md)
ROCKET_SECRETS_KEY_OLD=
# Connexion (voir docs/plan-gestion-utilisateurs.md) : en PRODUCTION, mot de passe du premier compte 'admin' (12 caracteres au moins, a changer des la premiere connexion).
# En developpement, le compte admin/admin est cree tout seul (changement obligatoire). LH_STRICT_AUTH=1 applique les regles de production meme en developpement.
ADMIN_INITIAL_PASSWORD=
# Facultatif : cle de chiffrement des sessions (32 caracteres au moins). Sinon generee dans .data/session-secret.
SESSION_SECRET=
PORT=3000
# Laisse vide pour utiliser les vraies donnees, ou mets 1 pour voir l'app avec des donnees de demo
DEMO=

# Interfaces web des briques (facultatif) : liens « géré dans Rocket PMS/Place » du menu Administration
PMS_FRONT_URL=
PLACE_FRONT_URL=
# Adresse publique de Rocket Console (facultatif) : lien « Créer un compte · choisir une offre » sur /connexion
# (vers <adresse>/inscription ; masqué si vide). Surchargeable à l'exécution par NUXT_PUBLIC_ROCKET_CONSOLE_PUBLIC_URL.
ROCKET_CONSOLE_PUBLIC_URL=

# --- Deploiement Docker (voir docs/deploiement.md) ---
DOMAIN=
# Adresse pour les alertes Let's Encrypt (expiration de certificat)
ACME_EMAIL=
# openssl rand -hex 24 (a sauvegarder)
N8N_ENCRYPTION_KEY=

# --- Rocket Auth (connexion unique de la suite Rocket, OpenID Connect) : voir docs/rocket-auth.md
# Vide = desactive (connexion locale seule, comportement inchange).
ROCKET_AUTH_URL=
ROCKET_AUTH_CLIENT_ID=loussahousing
# Identite de l'appli aupres de Rocket Auth (24 caracteres au moins). Phase 2 : ira dans le coffre de secrets du compte.
ROCKET_AUTH_CLIENT_SECRET=
ROCKET_AUTH_ADMIN_GROUP=rocket-admins
# Autres roles d'apres les groupes : role=groupe|groupe,...
ROCKET_AUTH_ROLE_GROUPS=
# 1 = cree le compte local a la premiere connexion (sinon : compte existant avec la meme adresse e-mail obligatoire)
ROCKET_AUTH_AUTOCREATE=0
# Role d'un compte cree quand aucun groupe ne correspond (vide = connexion refusee)
ROCKET_AUTH_DEFAULT_ROLE=
# Connexion locale gardee pendant la transition (0 pour la couper quand Rocket Auth est actif)
ROCKET_LOCAL_LOGIN=1
# Facultatif : adresses calculees sinon
ROCKET_AUTH_REDIRECT_URI=
ROCKET_AUTH_POST_LOGOUT_URI=
ROCKET_AUTH_APPS_URL=
